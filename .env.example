# Venator environment variables.
#
# Every variable below is read by the application source. No variable is listed
# here unless the code actually reads it (verified by grep against the tree).
#
# Load with, for example:
#   set -a; . ./.env; set +a; ~/.venv/bin/python main.py web
#
# Or set them in the systemd unit (see deploy/venator.service).

# TCP port the dashboard / HTTP API binds to. Read in venator/web.py:
#   PORT = int(os.environ.get("VENATOR_PORT", 8401))
# The server always binds 127.0.0.1 (loopback only); this changes the port, not
# the interface. Default when unset: 8401.
VENATOR_PORT=8401
